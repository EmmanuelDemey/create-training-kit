{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "oxc", "import", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "builtin": true,
    "node": true
  },
  // training.config.mjs of the template holds {{placeholders}}: not JavaScript
  // until create-training-kit fills them in. The starters of stacks/ leave
  // TODOs, unused parameters included, on purpose — and so do their translations
  // in locales/.
  "ignorePatterns": ["template/**", "stacks/**", "locales/**"]
}
